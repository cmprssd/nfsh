#!/usr/bin/env bash
# The checks every PR must pass, run on this machine by `local-ci` (claude-toolkit) in
# place of GitHub Actions. Run it directly to check without posting a status.
# Linux (WSL) and Windows (MSVC, via scripts/cargo-msvc.sh) run in parallel; each
# writes to its own target directory.
set -euo pipefail
cd "$(dirname "$0")"

step() { echo; echo "== $*"; }

step "format"; cargo fmt --all -- --check
step "shell syntax"; for f in scripts/*.sh .local-ci; do bash -n "$f"; done
step "python syntax"; for f in scripts/*.py; do python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read(), sys.argv[1])' "$f"; done
# OVERVIEW.md's generated blocks are counted from git, the tree and INVENTORY.md; rewrite
# them (python3 scripts/progress.py) so the docs never fall behind the code.
step "overview numbers"; python3 scripts/progress.py --check

# Build what is committed, not what happens to be in the working folder: a file the
# whitelist .gitignore leaves out fails here.
step "committed tree builds"
tree=$(mktemp -d)
logs=$(mktemp -d)
trap 'rm -rf "$logs" "$tree"' EXIT
# Extracted with the current time (-m), so cargo never reuses another branch's build
# of the shared target against these sources.
git archive HEAD | tar -x -m -C "$tree"
CARGO_TARGET_DIR="$PWD/target" cargo check --manifest-path "$tree/Cargo.toml" --workspace --all-targets --locked --quiet

linux() {
	cargo clippy --workspace --all-targets --locked -- -D warnings
	cargo test --workspace --locked
}
# The retail-data tests read the owner's game install and nfsh's store made from it
# (Windows side). Whichever is not reachable (drive unplugged, no import yet), the run
# still checks everything else and says so.
install='D:\SteamLibrary\steamapps\common\Need for Speed Heat'
store='D:\nfsh-store'
reachable() { (cd /mnt/c && powershell.exe -NoProfile -Command "exit !(Test-Path -LiteralPath '$1')"); }
windows() {
	scripts/cargo-msvc.sh clippy --workspace --all-targets --locked -- -D warnings
	local env=()
	if reachable "$install\Data\layout.toc"; then
		env+=(NFSH_INSTALL="$install")
	else
		echo "WARNING: $install not reachable; install tests skipped"
	fi
	if reachable "$store\index.nfsh"; then
		env+=(NFSH_STORE="$store")
	else
		echo "WARNING: $store not reachable; store tests skipped"
	fi
	env "${env[@]}" WSLENV="${WSLENV:-}:NFSH_INSTALL:NFSH_STORE" \
		scripts/cargo-msvc.sh test --workspace --locked
}

linux >"$logs/linux" 2>&1 & lpid=$!
windows >"$logs/windows" 2>&1 & wpid=$!
lstatus=0; wait $lpid || lstatus=$?
wstatus=0; wait $wpid || wstatus=$?

step "linux (exit $lstatus)"; cat "$logs/linux"
step "windows (exit $wstatus)"; cat "$logs/windows"
step "disk budget"; scripts/disk.sh prune
[ "$lstatus" -eq 0 ] && [ "$wstatus" -eq 0 ]
